}
model CatalogImage {
 id Uuid @id @default(uuid())
 mimeType VarChar(30) @map("mime_type")
 sizeBytes Int @map("size_bytes")
 createdBy Uuid @map("created_by")
 createdAt TimestamptzString @default(now()) @map("created_at")
 @@map("catalog_images")
}

model DesignModelGroup {
 workflowRevisions ProductionWorkflowRevision[]
 defaultLaborPricePer15g Numeric(20,4)? @map("default_labor_price_per_15g")
 id Uuid @id @default(uuid())
 name VarChar(180)
 createdAt TimestamptzString @default(now()) @map("created_at")
 updatedAt TimestamptzString @default(now()) @map("updated_at")
 createdBy Uuid? @map("created_by")
 updatedBy Uuid? @map("updated_by")
 designs DesignModel[]
 @@map("design_model_groups")
}

// Ordered steps and dependency edges are stored in each immutable JSON definition.
// API validation enforces a DAG. No template copies are stored for INHERIT models.
model ProductionWorkflowRevision {
 id Uuid @id @default(uuid())
 groupId Uuid? @map("group_id")
 group DesignModelGroup? @relation(fields:[groupId],references:[id])
 modelId Uuid? @map("model_id")
 model DesignModel? @relation(fields:[modelId],references:[id])
 revision Int
 definition Json
 createdBy Uuid @map("created_by")
 createdAt TimestamptzString @default(now()) @map("created_at")
 @@unique([groupId,revision])
 @@unique([modelId,revision])
 @@map("production_workflow_revisions")
}

// Gold only: labor remains in its existing per-currency ledger.
model CustomerLedgerMonthlyBalance {
  id Uuid @id @default(uuid())
  customerId Uuid @map("customer_id")
  period DateString
  closingGoldG Numeric(30, 4) @map("closing_gold_g")
  calculatedAt TimestamptzString @map("calculated_at")
  isDirty Boolean @default(false) @map("is_dirty")
  @@unique([customerId, period])
  @@map("customer_ledger_monthly_balances")
}

