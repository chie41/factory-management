}
model BatchStepDependency {
 batchId Uuid @map("batch_id")
 stepId VarChar(80) @map("step_id")
 dependsOnId VarChar(80) @map("depends_on_id")
 step BatchStep @relation("BatchDependencies",fields:[batchId,stepId],references:[batchId,stepId])
 dependency BatchStep @relation("BatchDependents",fields:[batchId,dependsOnId],references:[batchId,stepId])
 @@id([batchId,stepId,dependsOnId])
 @@map("batch_step_dependencies")
}
model BatchStatusHistory {
