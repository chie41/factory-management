 @@map("batch_loss_entries")
}
model BatchLaborEntry {
 id Uuid @id @default(uuid())
 batchId Uuid @map("batch_id")
 stepId VarChar(80) @map("step_id")
 employeeId Uuid @map("employee_id")
 outputId Uuid? @map("output_id")
 amount Numeric(20,4)
 currency Char(3) @default("THB")
 direction VarChar(10)
 adjustsId Uuid? @map("adjusts_id")
 ratePer15g Numeric(20,4)? @map("rate_per_15g")
 calculationNote String @map("calculation_note")
