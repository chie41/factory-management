 @@id([outputId,assignmentId])
 @@map("batch_output_contributions")
}
model BatchMaterialMovement {
 id Uuid @id @default(uuid())
 batchId Uuid @map("batch_id")
 stepId VarChar(80) @map("step_id")
 employeeId Uuid @map("employee_id")
 materialType VarChar(20) @map("material_type")
 materialName VarChar(120) @map("material_name")
 unit VarChar(10)
 quantity Numeric(20,4)
 kind VarChar(30)
 effect Int @default(1)
 groupId Uuid @map("group_id")
 reversesId Uuid? @unique @map("reverses_id")
 occurredAt TimestamptzString @map("occurred_at")
 note String?
 createdBy Uuid @map("created_by")
