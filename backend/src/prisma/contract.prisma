 receivedGoldG Numeric(24,4)? @map("received_gold_g")
 differenceGoldG Numeric(24,4)? @map("difference_gold_g")
 closedBy Uuid? @map("closed_by")
 closedAt TimestamptzString? @map("closed_at")
 updatedAt TimestamptzString @default(now()) @map("updated_at")
 @@map("batch_worker_reconciliations")
}
model BatchReconciliationEvent {
 id Uuid @id @default(uuid())
 assignmentId Uuid @map("assignment_id")
 action VarChar(10)
 reason String
 beforeState Json? @map("before_state")
 afterState Json @map("after_state")
 actorId Uuid @map("actor_id")
