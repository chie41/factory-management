// use prisma-8

// ==========================================
// 1. ROLES
// ==========================================
model Role {
  id   Uuid         @id @default(uuid())
  code VarChar(50)  @unique
  name VarChar(120)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// ==========================================
// 2. PERMISSIONS
// ==========================================
model Permission {
  id   Uuid         @id @default(uuid())
  code VarChar(120) @unique
  name VarChar(180)

  rolePermissions  RolePermission[]
  groupPermissions GroupPermission[]
  userPermissions  UserPermission[]

  @@map("permissions")
}

// ==========================================
// 3. EMPLOYEES
// ==========================================
model Employee {
  id           Uuid               @id @default(uuid())
  employeeCode VarChar(50)        @unique @map("employee_code")
  fullName     VarChar(180)       @map("full_name")
  phone        VarChar(30)?
  startDate    DateString?       @map("start_date")
  roleLabel    VarChar(120)?      @map("role_label")
  status       VarChar(30)        @default("ACTIVE")
  note         String?
  createdAt    TimestamptzString  @default(now()) @map("created_at")
  updatedAt    TimestamptzString  @default(now()) @map("updated_at")
  deletedAt    TimestamptzString? @map("deleted_at")

  users User[]

  @@map("employees")
}

// ==========================================
// 4. USERS
// ==========================================
model User {
  id           Uuid               @id @default(uuid())
  username     VarChar(100)       @unique
  passwordHash String             @map("password_hash")
  employeeId   Uuid?              @map("employee_id")
  status       VarChar(30)        @default("ACTIVE")
  createdAt    TimestamptzString  @default(now()) @map("created_at")
  updatedAt    TimestamptzString  @default(now()) @map("updated_at")
  deletedAt    TimestamptzString? @map("deleted_at")

  employeeLinkExempt Boolean @default(false) @map("employee_link_exempt")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  loginBlockedUntil TimestamptzString? @map("login_blocked_until")
  passwordChangedAt TimestamptzString? @map("password_changed_at")

  employee        Employee?        @relation(fields: [employeeId], references: [id])
  userRoles       UserRole[]
  userGroups      UserGroup[]
  userPermissions UserPermission[]

  ledgerCreates CustomerLedger[] @relation("LedgerCreatedBy")
  ledgerUpdates  CustomerLedger[] @relation("LedgerUpdatedBy")
  ledgerReverses CustomerLedger[] @relation("LedgerReversedBy")

  @@index([employeeId], unique: true, where: "(deleted_at IS NULL)", map: "users_live_employee_unique")
  @@map("users")
}

// ==========================================
// 5. USER ROLES
// ==========================================
model UserRole {
  userId Uuid @map("user_id")
  roleId Uuid @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==========================================
// 6. ROLE PERMISSIONS
// ==========================================
model RolePermission {
  roleId       Uuid @map("role_id")
  permissionId Uuid @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// 7. GROUPS
// ==========================================
model Group {
  id        Uuid               @id @default(uuid())
  code      VarChar(50)        @unique
  name      VarChar(120)
  deletedAt TimestamptzString? @map("deleted_at")

  userGroups       UserGroup[]
  groupPermissions GroupPermission[]

  @@map("groups")
}

// ==========================================
// 8. USER GROUPS
// ==========================================
model UserGroup {
  userId  Uuid @unique @map("user_id")
  groupId Uuid @map("group_id")

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
  @@map("user_groups")
}

// ==========================================
// 9. GROUP PERMISSIONS
// ==========================================
model GroupPermission {
  groupId      Uuid @map("group_id")
  permissionId Uuid @map("permission_id")

  group      Group      @relation(fields: [groupId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([groupId, permissionId])
  @@map("group_permissions")
}

// ==========================================
// 10. USER PERMISSIONS
// ==========================================
model UserPermission {
  userId       Uuid @map("user_id")
  permissionId Uuid @map("permission_id")

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// ==========================================
// 11. CUSTOMERS
// ==========================================
model Customer {
  id           Uuid               @id @default(uuid())
  customerCode VarChar(50)        @unique @map("customer_code")
  name         VarChar(180)
  phone        VarChar(30)?
  address      String?
  status       VarChar(30)        @default("ACTIVE")
  note         String?
  createdAt    TimestamptzString  @default(now()) @map("created_at")
  updatedAt    TimestamptzString  @default(now()) @map("updated_at")
  deletedAt    TimestamptzString? @map("deleted_at")

  ledgerEntries CustomerLedger[]

  @@map("customers")
}

// ==========================================
// 12. CUSTOMERS LEDGERS
// ==========================================
model CustomerLedger {
  id                 Uuid               @id @default(uuid())

  customerId         Uuid               @map("customer_id")
  customer           Customer           @relation(fields: [customerId], references: [id])

  businessDate       DateString         @map("business_date")
  occurredAt         TimestamptzString  @map("occurred_at")

  transactionType    VarChar(50)        @map("transaction_type")
  goldWeightG        Numeric(20, 4)     @map("gold_weight_g")
  actualWeightG Numeric(20, 4)? @map("actual_weight_g")
  purityPercent Numeric(7, 4)? @map("purity_percent")
  recoveredExactGoldG Numeric(30, 10)? @map("recovered_exact_gold_g")
  requestId Uuid? @map("request_id")
  approvalStatus VarChar(30) @default("LEGACY") @map("approval_status")
  approvedBy Uuid? @map("approved_by")
  approvedAt TimestamptzString? @map("approved_at")
  createdBy Uuid? @map("created_by")
  createdByUser User? @relation("LedgerCreatedBy", fields: [createdBy], references: [id])

  laborAmountDue     Numeric(20, 4)     @default(0) @map("labor_amount_due")
  laborAmountPaid    Numeric(20, 4)     @default(0) @map("labor_amount_paid")
  laborCurrency      Char(3)?           @map("labor_currency")
  laborPaymentStatus VarChar(30)        @default("UNPAID") @map("labor_payment_status")

  referenceType      VarChar(50)?       @map("reference_type")
  referenceId        Uuid?              @map("reference_id")

  description        VarChar(255)?
  note               String?

  createdAt          TimestamptzString  @default(now()) @map("created_at")

  updatedBy          Uuid?              @map("updated_by")
  updatedAt          TimestamptzString? @map("updated_at")
  updatedByUser      User?              @relation("LedgerUpdatedBy", fields: [updatedBy], references: [id])

  reversedAt         TimestamptzString? @map("reversed_at")
  reversedBy         Uuid?              @map("reversed_by")
  reversedByUser     User?              @relation("LedgerReversedBy", fields: [reversedBy], references: [id])

  @@index([customerId])
  @@index([businessDate])
  @@map("customers_ledger")
}



model DesignModel {
 productionBatches ProductionBatch[]
 workflowMode VarChar(10) @default("INHERIT") @map("workflow_mode")
 workflowRevisions ProductionWorkflowRevision[]
 groupId Uuid? @map("group_id")
 group DesignModelGroup? @relation(fields:[groupId],references:[id])
 id Uuid @id @default(uuid())
 code VarChar(80) @unique
 name VarChar(180)
 status VarChar(30) @default("ACTIVE")
 defaultLaborPricePer15g Numeric(20,4)? @map("default_labor_price_per_15g")
 defaultLaborCurrency Char(3)? @map("default_labor_currency")
 imageUrl String? @map("image_url")
 weightG Numeric(20,4)? @map("weight_g")
 designDescription String? @map("design_description")
 note String?
 createdAt TimestamptzString @default(now()) @map("created_at")
 updatedAt TimestamptzString @default(now()) @map("updated_at")
 createdBy Uuid? @map("created_by")
 updatedBy Uuid? @map("updated_by")
 boms Bom[]
 @@map("design_models")
}

model ProductionBatch {
 standardWeightPerUnitG Numeric(20,4)? @map("standard_weight_per_unit_g")
 plannedStartAt TimestamptzString? @map("planned_start_at")
 plannedEndAt TimestamptzString? @map("planned_end_at")
 id Uuid @id @default(uuid())
 code VarChar(50) @unique
 designModelId Uuid @map("design_model_id")
 designModel DesignModel @relation(fields:[designModelId],references:[id])
 modelCodeSnapshot VarChar(80) @map("model_code_snapshot")
 modelNameSnapshot VarChar(180) @map("model_name_snapshot")
 plannedQuantity Int @map("planned_quantity")
 productUnit VarChar(30) @default("PCS") @map("product_unit")
 status VarChar(40) @default("DRAFT")
 plannedStart DateString? @map("planned_start")
 plannedEnd DateString? @map("planned_end")
 actualStart TimestamptzString? @map("actual_start")
 actualEnd TimestamptzString? @map("actual_end")
 note String?
 sourceRevisionId Uuid @map("source_revision_id")
 sourceMetadata Json @map("source_metadata")
 revision Int @default(1)
 requestId Uuid @unique @map("request_id")
 intentHash String @map("intent_hash")
 createdBy Uuid @map("created_by")
 updatedBy Uuid @map("updated_by")
 createdAt TimestamptzString @default(now()) @map("created_at")
 updatedAt TimestamptzString @default(now()) @map("updated_at")
 snapshots BatchWorkflowSnapshot[]
 steps BatchStep[]
 statusHistory BatchStatusHistory[]
 auditEvents BatchAuditEvent[]
 @@index([designModelId,status],map:"production_batches_model_status_idx")
 @@map("production_batches")
}
model BatchWorkflowSnapshot {
 id Uuid @id @default(uuid())
 batchId Uuid @map("batch_id")
 batch ProductionBatch @relation(fields:[batchId],references:[id])
 revision Int
 definition Json
 createdBy Uuid @map("created_by")
 createdAt TimestamptzString @default(now()) @map("created_at")
 @@unique([batchId,revision])
 @@map("batch_workflow_snapshots")
}
model BatchStep {
 estimatedDurationMinutes Int? @map("estimated_duration_minutes")
 executionStatus VarChar(20) @default("NOT_STARTED") @map("execution_status")
 completedQuantity Int @default(0) @map("completed_quantity")
 executionFinishedAt TimestamptzString? @map("execution_finished_at")
 executionLockedAt TimestamptzString? @map("execution_locked_at")
 batchId Uuid @map("batch_id")
 batch ProductionBatch @relation(fields:[batchId],references:[id])
 stepId VarChar(80) @map("step_id")
 displayOrder Int @map("display_order")
 name VarChar(180)
 description String @default("")
 laborRatePer15g Numeric(20,4)? @map("labor_rate_per_15g")
 requiresEmployeeConfirmation Boolean @default(false) @map("requires_employee_confirmation")
 executionStartedAt TimestamptzString? @map("execution_started_at")
 dependencies BatchStepDependency[] @relation("BatchDependencies")
 dependents BatchStepDependency[] @relation("BatchDependents")
 @@id([batchId,stepId])
 @@map("batch_steps")
}

model BatchExecutionRequest {
 requestId Uuid @id @map("request_id")
 batchId Uuid @map("batch_id")
 actorId Uuid @map("actor_id")
 intentHash String @map("intent_hash")
 result Json
 createdAt TimestamptzString @default(now()) @map("created_at")
 @@map("batch_execution_requests")
}
model BatchAssignment {
 appliedLaborRatePer15g Numeric(20,4)? @map("applied_labor_rate_per_15g")
 id Uuid @id @default(uuid())
 batchId Uuid @map("batch_id")
 stepId VarChar(80) @map("step_id")
 employeeId Uuid @map("employee_id")
 plannedQuantity Int? @map("planned_quantity")
 assignedAt TimestamptzString @map("assigned_at")
 status VarChar(20) @default("ACTIVE")
 note String?
 createdBy Uuid @map("created_by")
 updatedBy Uuid @map("updated_by")
 createdAt TimestamptzString @default(now()) @map("created_at")
 updatedAt TimestamptzString @default(now()) @map("updated_at")
 contributions BatchOutputContribution[]
 @@unique([batchId,stepId,employeeId])
 @@map("batch_assignments")
}

model BatchAssignmentEvent {
 id Uuid @id @default(uuid())
 assignmentId Uuid @map("assignment_id")
 quantityDelta Int @map("quantity_delta")
 resultingQuantity Int? @map("resulting_quantity")
 kind VarChar(10)
 beforeState Json? @map("before_state")
 afterState Json @map("after_state")
 actorId Uuid @map("actor_id")
 createdAt TimestamptzString @default(now()) @map("created_at")
 @@map("batch_assignment_events")
}
model BatchWorkerReconciliation {
