 @@map("batch_reconciliation_events")
}
model BatchOutput {
 id Uuid @id @default(uuid())
 batchId Uuid @map("batch_id")
 stepId VarChar(80) @map("step_id")
 workReference VarChar(160) @map("work_reference")
 quantity Int
 occurredAt TimestamptzString @map("occurred_at")
 note String?
