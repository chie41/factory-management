 nameSnapshot VarChar(180)? @map("name_snapshot")
 quantity Numeric(20,4)?
 weightG Numeric(20,4)? @map("weight_g")
 unit VarChar(30)?
 @@index([componentId],map:"bom_items_component_idx")
 @@index([bomId],map:"bom_items_bom_idx")
