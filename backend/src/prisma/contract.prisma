 @@unique([batchId,stepId,workReference])
 @@map("batch_outputs")
}
model BatchOutputContribution {
 outputId Uuid @map("output_id")
 output BatchOutput @relation(fields:[outputId],references:[id])
 assignmentId Uuid @map("assignment_id")
 assignment BatchAssignment @relation(fields:[assignmentId],references:[id])
