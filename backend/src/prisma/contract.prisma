 batchId Uuid @map("batch_id")
 batch ProductionBatch @relation(fields:[batchId],references:[id])
 fromStatus VarChar(40)? @map("from_status")
 toStatus VarChar(40) @map("to_status")
 reason String
 actorId Uuid @map("actor_id")
 createdAt TimestamptzString @default(now()) @map("created_at")
 @@index([batchId,createdAt,id],map:"batch_status_history_batch_idx")
 @@map("batch_status_history")
}
model BatchAuditEvent {
 id Uuid @id @default(uuid())
 batchId Uuid @map("batch_id")
 batch ProductionBatch @relation(fields:[batchId],references:[id])
 action VarChar(80)
 beforeState Json? @map("before_state")
 afterState Json @map("after_state")
 actorId Uuid @map("actor_id")
 createdAt TimestamptzString @default(now()) @map("created_at")
 @@index([batchId,createdAt,id],map:"batch_audit_events_batch_idx")
 @@map("batch_audit_events")
}
model Component {
