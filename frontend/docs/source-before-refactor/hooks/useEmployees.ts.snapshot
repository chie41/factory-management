import { useEffect, useMemo, useState } from 'react'
import type { Employee } from '../types/models'
import { sampleEmployees } from '../data/samples'
import { api } from '../services/api'
import { listFrom } from '../utils/listFrom'
export function useEmployees() {
  const [rows, setRows] = useState<Employee[]>(sampleEmployees)
  const [loading, setLoading] = useState(false)
  const [search, setSearch] = useState('')
  useEffect(() => {
    setLoading(true)
    api.get('/users', { params: { page: 1, limit: 20 } })
      .then((res) => setRows(listFrom<Employee>(res.data, sampleEmployees).rows))
      .catch(() => setRows(sampleEmployees))
      .finally(() => setLoading(false))
  }, [])
  const filtered = useMemo(() => rows.filter((row) => JSON.stringify(row).toLowerCase().includes(search.toLowerCase())), [rows, search])
  const activeCount = rows.filter((row) => (row.status ?? '').toLowerCase().includes('hoạt') || row.isActive).length
  return { rows, loading, search, setSearch, filtered, activeCount }
}