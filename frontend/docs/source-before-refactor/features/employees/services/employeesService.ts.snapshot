import { apiClient } from '../../../services/apiClient'
import { listFrom } from '../../../types/api'
import { sampleEmployees } from '../data/sampleEmployees'
import type { Employee } from '../types/employee'

export async function fetchEmployees() {
  const response = await apiClient.get('/users', { params: { page: 1, limit: 20 } })
  return listFrom<Employee>(response.data, sampleEmployees).rows
}
