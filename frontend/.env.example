# Same-origin API; Vite proxies /api to localhost:3000 in development.
VITE_API_BASE_URL=/api/v1
# current = backend in this repository; documented = supplied Swagger 1.1 paths/payloads.
VITE_API_CONTRACT=current
# To test a backend on another port, set API_PROXY_TARGET in the shell before npm run dev.
# Production must route /api to the backend, or use an HTTPS API base URL with backend CORS configured.
